# ── Domains & TLS ──────────────────────────────────────────────────────────
# Sottodomini su cui Caddy emette TLS automatica (Let's Encrypt).
# Devono già puntare via DNS al droplet PRIMA del primo `up -d` di caddy.
DOMAIN_API=api.mydit.app
DOMAIN_WS=ws.mydit.app
# Host storici su mariustrica.com, serviti in parallelo dallo stesso Caddy.
# NON rimuoverli finché esistono installazioni delle build che li hanno
# compilati dentro (EXPO_PUBLIC_API_URL / EXPO_PUBLIC_WS_URL): l'app non ha
# force-update, quindi chi non aggiorna resta agganciato al vecchio host.
# Ritirarli significa togliere sia queste var sia i record DNS.
DOMAIN_API_LEGACY=dit-api.mariustrica.com
DOMAIN_WS_LEGACY=dit-ws.mariustrica.com
# Email per gli avvisi di Let's Encrypt: rinnovo fallito, certificato in
# scadenza. Dev'essere una casella che qualcuno legge davvero — è l'unico
# canale che segnala un rinnovo rotto, e un certificato scaduto non dà altro
# preavviso. Non lasciare il valore d'esempio: qui era rimasto per mesi.
ACME_EMAIL=you@mydit.app

# ── GHCR (GitHub Container Registry) ───────────────────────────────────────
# Owner GitHub (user) sotto cui vengono pushate le immagini: ghcr.io/tricaman/<repo>
GHCR_USER=tricaman
# Tag delle immagini da deployare (default: latest). Per pinning usa SHA o version.
DIT_API_TAG=latest
DIT_PING_TAG=latest
DIT_WORKER_TAG=latest

# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_USER=dit
# IMPORTANTE: cambia questa password — non lasciare il default
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=dit

# ── JWT (condiviso tra dit-api e dit-ping) ─────────────────────────────────
# Genera con: openssl rand -hex 32
JWT_SECRET=change_me_minimum_32_characters_long

# ── BetterAuth ─────────────────────────────────────────────────────────────
# Genera con: openssl rand -hex 32
BETTER_AUTH_SECRET=change_me_minimum_32_characters_long
# Origini consentite separate da virgola (mobile uses scheme dit://).
# L'host legacy resta in lista finché il Caddyfile lo serve: le vecchie build
# arrivano ancora da lì.
TRUSTED_ORIGINS=dit://,https://api.mydit.app,https://dit-api.mariustrica.com
#
# Base URL. LASCIARE VUOTA: BetterAuth la ricava per richiesta dall'host in
# arrivo, così un login che parte da un host ci ritorna. Il cookie `state` di
# OAuth è legato all'host: fissandola, le build vecchie partirebbero da
# mariustrica.com e la callback arriverebbe su mydit.app, dove quel cookie non
# esiste — `state_security_mismatch`, login Google rotto per chi non ha ancora
# aggiornato. Valorizzala SOLO per fissare un'origine come rollback.
BETTER_AUTH_URL=

# ── Email transazionali ────────────────────────────────────────────────────
# Transport attivo: ses | brevo | log. Qualsiasi altro valore (typo, vuoto)
# significa brevo. `log` stampa l'email — OTP compreso — nel log del server:
# MAI in produzione.
#
# Il cambio è una variabile + restart, in entrambe le direzioni: le credenziali
# dei due provider convivono, e viene validato al boot solo il transport
# selezionato. Per tornare a Brevo: EMAIL_TRANSPORT=brevo e riavvia dit-api.
EMAIL_TRANSPORT=ses
#
# Mittente. Deve stare su un dominio verificato presso il transport attivo, o
# l'invio viene rifiutato. Se assente si ricade su BREVO_SENDER_EMAIL.
MAIL_FROM=noreply@mydit.app

# ── Amazon SES via SMTP (EMAIL_TRANSPORT=ses) ──────────────────────────────
# Credenziali SMTP dalla console SES, NON access key IAM: la password è
# derivata per regione, vanno generate con la console su eu-central-1.
# Il dominio mittente richiede identità verificata + Easy DKIM + un MAIL FROM
# personalizzato (mail.mydit.app), altrimenti SPF non si allinea per DMARC.
#
# Ricostruendo l'ambiente da zero: l'account SES dev'essere FUORI dalla sandbox
# prima di puntarci il traffico. In sandbox si scrive solo a indirizzi
# verificati (200/giorno) e ogni OTP verso un utente reale fallirebbe.
SMTP_HOST=email-smtp.eu-central-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Brevo (EMAIL_TRANSPORT=brevo) — rollback ───────────────────────────────
# Tenute valorizzate anche mentre gira SES: sono la via di ritorno immediata.
# Ora sono davvero opzionali. Con lo schema precedente il boot le pretendeva
# comunque, perché trattava `ses` come `brevo`: svuotarle avrebbe fatto
# crashare dit-api con un errore che parlava di Brevo su un ambiente SES.
BREVO_API_KEY=xkeysib-your-api-key
BREVO_SENDER_EMAIL=noreply@mydit.app

# ── OAuth providers ────────────────────────────────────────────────────────
# Redirect URI da configurare nei provider:
#   https://api.mydit.app/auth/callback/google
#   https://api.mydit.app/auth/callback/facebook
#   https://api.mydit.app/auth/callback/microsoft
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# ── Sign in with Apple (native iOS) ────────────────────────────────────────
# Bundle identifier accettati come claim `aud` dell'id_token, uno per variante
# dell'app. dit-api registra il provider Apple SOLO se questa è valorizzata:
# se manca, ogni login Apple fallisce con PROVIDER_NOT_FOUND (401 lato app).
# Richiede la capability "Sign In with Apple" attiva sui rispettivi App ID.
APPLE_APP_BUNDLE_IDS=com.mariustrica.dit,com.mariustrica.dit.dev,com.mariustrica.dit.preview

# ── Firebase Admin SDK (push notifications) ────────────────────────────────
# Incolla l'intero JSON del service account su una sola riga (escapa newline come \n)
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── dit-ping tuning (opzionali) ────────────────────────────────────────────
PING_DEFAULT_TTL_SECONDS=3600
PING_MAX_TTL_SECONDS=86400
HUB_MAX_CONNECTIONS_PER_USER=5
AUTH_TIMEOUT_SECONDS=5
HEARTBEAT_INTERVAL_SECONDS=30
HEARTBEAT_TIMEOUT_SECONDS=60
BULL_QUEUE_NAME=notif

# ── dit-worker tuning ──────────────────────────────────────────────────────
WORKER_CONCURRENCY=10

# ── Reviewer backdoor (Play Store / App Store review ONLY) ────────────────
# Lets the whitelisted emails log in with a fixed OTP, bypassing the
# magic-link email send. NEVER enable for normal production traffic.
# See dit-api/decisions.md for the full rationale and removal plan.
# REVIEWER_BACKDOOR_EMAILS is a comma-separated list (trimmed, case-insensitive).
REVIEWER_BACKDOOR_ENABLED=false
REVIEWER_BACKDOOR_EMAILS=
REVIEWER_BACKDOOR_OTP=
