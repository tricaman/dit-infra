{
    email {$ACME_EMAIL}
}

# ── REST API (dit-api) ────────────────────────────────────────────────────
# Due host, stesso backend. {$DOMAIN_API} è quello corrente; il legacy resta
# perché l'URL dell'API è compilata dentro il binario dell'app
# (EXPO_PUBLIC_API_URL in eas.json) e non esiste un meccanismo di force-update:
# ogni installazione già distribuita continua a chiamare il vecchio host finché
# l'utente non aggiorna — e chi non aggiorna mai, non aggiorna mai.
# Per ritirarlo: togli l'indirizzo da qui E il record DNS, non prima che le
# build che lo referenziano siano fuori uso.
{$DOMAIN_API}, {$DOMAIN_API_LEGACY:dit-api.mariustrica.com} {
    encode gzip zstd

    reverse_proxy dit-api:3000

    log {
        output stdout
        format console
    }
}

# ── WebSocket (dit-ping) ──────────────────────────────────────────────────
# Stesso discorso del blocco sopra per l'host legacy (EXPO_PUBLIC_WS_URL).
{$DOMAIN_WS}, {$DOMAIN_WS_LEGACY:dit-ws.mariustrica.com} {
    encode gzip zstd

    # Endpoint WebSocket
    handle /ws {
        reverse_proxy dit-ping:8080
    }

    # Health check (es. https://ws.mydit.app/health)
    handle /health {
        reverse_proxy dit-ping:8080
    }

    # Tutto il resto → 404 (dit-ping non espone altri path)
    handle {
        respond 404
    }

    log {
        output stdout
        format console
    }
}
