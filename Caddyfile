{
    email {$ACME_EMAIL}
}

# ── REST API (dit-api) ────────────────────────────────────────────────────
# Due host, stesso backend. {$DOMAIN_API} è quello corrente; il legacy resta
# perché l'URL dell'API è compilata dentro il binario dell'app
# (EXPO_PUBLIC_API_URL in eas.json) e non esiste un meccanismo di force-update:
# ogni installazione già distribuita continua a chiamare il vecchio host finché
# l'utente non aggiorna — e chi non aggiorna mai, non aggiorna mai.
# Per ritirarlo: togli l'indirizzo da qui E il record DNS, non prima che le
# build che lo referenziano siano fuori uso.
{$DOMAIN_API}, {$DOMAIN_API_LEGACY:dit-api.mariustrica.com} {
    encode gzip zstd

    reverse_proxy dit-api:3000

    log {
        output stdout
        format console
    }
}

# ── WebSocket (dit-ping) ──────────────────────────────────────────────────
# Stesso discorso del blocco sopra per l'host legacy (EXPO_PUBLIC_WS_URL).
{$DOMAIN_WS}, {$DOMAIN_WS_LEGACY:dit-ws.mariustrica.com} {
    encode gzip zstd

    # Endpoint WebSocket
    handle /ws {
        reverse_proxy dit-ping:8080
    }

    # Health check (es. https://ws.mydit.app/health)
    handle /health {
        reverse_proxy dit-ping:8080
    }

    # Tutto il resto → 404 (dit-ping non espone altri path)
    handle {
        respond 404
    }

    log {
        output stdout
        format console
    }
}

# ── Attenzione: in produzione questo file ha blocchi in più ────────────────
# Sul droplet il Caddyfile ha in coda uno o più site block NON versionati,
# aggiunti a mano per progetti che condividono questo host (oggi:
# clash-bot.mariustrica.com). È una scelta deliberata — sono side project
# piccoli, non valeva la pena portarli qui dentro. Le conseguenze però sono
# reali, e tutte silenziose:
#
#   • `git pull` in /opt/dit fallisce finché quei blocchi ci sono. Procedura:
#     salvali (`sed -n '/^# ── <Nome>/,$p' Caddyfile > /tmp/blocco`),
#     `git checkout -- Caddyfile`, `git pull`, ri-appendili, poi valida.
#   • `git checkout` / `git stash` / `git reset --hard` su questo file li
#     cancella, e quei siti smettono di rispondere senza alcun errore.
#   • Il "Setup completo da zero" del README NON li ricrea.
#
# Cosa c'è davvero in produzione, in un comando: `git diff Caddyfile`
